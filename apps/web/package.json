{
  "name": "certinova-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen:schema": "graphql-codegen --config codegen.schema.ts",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@urql/vue": "^1.4.3",
    "frappe-ui": "^1.2.0",
    "graphql": "^16.15.0",
    "graphql-ws": "^6.4.3",
    "papaparse": "^5.7.1",
    "qrcode": "^1.5.4",
    "read-excel-file": "^9.3.20",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
