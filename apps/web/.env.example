# apps/web — copy to apps/web/.env.local. Only public values belong here:
# Vite puts every VITE_* value into the browser bundle.

# Supabase project (Settings > API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Hasura Cloud project (GraphQL API endpoint)
VITE_HASURA_GRAPHQL_URL=https://<project>.hasura.app/v1/graphql

# Local stack: VITE_SUPABASE_URL=http://127.0.0.1:54321, the publishable key from
# `npm run supabase -- status`, and VITE_HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
