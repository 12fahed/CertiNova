# apps/api — copy to apps/api/.env for local runs. Never commit real values.

# dev | staging | prod | test
APP_ENV=dev
LOG_LEVEL=INFO

# Added in later phases (P3). Listed here so every secret has one home.
# Supabase Postgres (Settings > Database > Connection string, session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Render Redis (internal URL in Render, external URL for local runs)
REDIS_URL=rediss://red-xxxxxxxx:<password>@<region>-redis.render.com:6379
# Shared with Hasura Cloud; Hasura sends it on every action and event-trigger call
HASURA_ACTION_SECRET=change-me
# Supabase project (Settings > API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Outgoing mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
