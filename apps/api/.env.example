# apps/api — copy to apps/api/.env for local runs. Never commit real values.
# The API and the worker read the same variables. Defaults below match the local stack.

# dev | staging | prod | test. Staging and prod refuse to start with local default secrets.
APP_ENV=dev
LOG_LEVEL=INFO

# Supabase Postgres. Deployed: session pooler URL (Settings > Database > Connection string).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Render Redis: internal URL on Render, external URL for local runs.
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=certinova

# Shared with Hasura Cloud. Hasura sends it on every action call.
HASURA_ACTION_SECRET=local-action-secret

# Supabase project (Settings > API). Use the secret key (sb_secret_...) or the legacy service_role key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SIGNED_URL_TTL_SECONDS=600

# Public URL of the web app. Used in verify links, QR codes and invite emails.
FRONTEND_URL=http://localhost:5173

# Outgoing mail. Leave SMTP_HOST empty to log emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM_ADDRESS=CertiNova <no-reply@certinova.local>

# Font cache for the renderer. Missing Google Fonts are downloaded once into this folder.
FONTS_DIR=fonts
FONTS_DOWNLOAD=true
