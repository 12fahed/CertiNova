#!/usr/bin/env sh

# ---------- Colors ----------
RESET='\033[0m'
BOLD='\033[1m'

RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
BLUE='\033[34m'
CYAN='\033[36m'
GRAY='\033[90m'

# ---------- Helpers ----------

header() {
  echo ""
  printf "${CYAN}${BOLD}============================================================${RESET}\n"
  printf "${CYAN}${BOLD}  %s${RESET}\n" "$1"
  printf "${CYAN}${BOLD}============================================================${RESET}\n"
}

step() { printf "${BLUE}[RUNNING]${RESET} %s\n" "$1"; }
ok() { printf "${GREEN}[PASS]${RESET} %s\n" "$1"; }
warn() { printf "${YELLOW}[WARN]${RESET} %s\n" "$1"; }
fail() { printf "${RED}[FAIL]${RESET} %s\n" "$1"; }
divider() { printf "${GRAY}------------------------------------------------------------${RESET}\n"; }

has_staged() {
  git diff --cached --name-only --diff-filter=ACMR -- "$1" | grep -q .
}

# Re-stage only files that were already staged, so formatter fixes never pull in unrelated work.
restage() {
  git diff --cached --name-only --diff-filter=ACMR -- "$1" | xargs -r git add --
}

# ---------- Legacy Node apps ----------

check_legacy() {
  DIR=$1
  TS=$2

  header "Checking: $DIR"
  START=$(date +%s)
  cd "$DIR" || exit 1

  if [ ! -d "node_modules" ]; then
    step "Installing dependencies"
    npm install || { fail "Dependency installation failed"; exit 1; }
  fi
  ok "Dependencies available"
  divider

  if [ "$TS" = true ]; then
    step "Running TypeScript"
    npx tsc --noEmit --pretty || { fail "TypeScript errors found"; exit 1; }
    ok "TypeScript passed"
    divider
  fi

  step "Checking formatting"
  if npx prettier --check . >/dev/null 2>&1; then
    ok "Formatting passed"
  else
    npx prettier --write . >/dev/null
    cd - >/dev/null
    restage "$DIR"
    cd "$DIR" || exit 1
    ok "Formatting fixed"
  fi
  divider

  step "Running ESLint"
  npx eslint . --fix --no-error-on-unmatched-pattern && ok "Lint passed" || warn "Lint warnings (non-blocking)"

  cd - >/dev/null
  printf "${GREEN}${BOLD}Completed in %ss${RESET}\n" "$(($(date +%s) - START))"
}

# ---------- Revamp: Python packages ----------

check_python() {
  DIR=$1

  header "Checking: $DIR"
  command -v uv >/dev/null || { fail "uv is not installed (https://docs.astral.sh/uv/)"; exit 1; }

  step "Running ruff format"
  uv run --directory "$DIR" ruff format . >/dev/null || { fail "ruff format failed"; exit 1; }
  restage "$DIR"
  ok "Formatting passed"

  step "Running ruff check"
  uv run --directory "$DIR" ruff check . || { fail "ruff found problems"; exit 1; }
  ok "Lint passed"
}

# ---------- Revamp: web app ----------

check_web() {
  DIR=$1

  header "Checking: $DIR"
  [ -d "$DIR/node_modules" ] || (cd "$DIR" && npm ci) || { fail "npm ci failed"; exit 1; }

  step "Running prettier"
  (cd "$DIR" && npx prettier --write . >/dev/null) || { fail "prettier failed"; exit 1; }
  restage "$DIR"
  ok "Formatting passed"

  step "Running ESLint"
  (cd "$DIR" && npm run --silent lint) || { fail "ESLint found problems"; exit 1; }
  ok "Lint passed"

  step "Running vue-tsc"
  (cd "$DIR" && npm run --silent type-check) || { fail "Type errors found"; exit 1; }
  ok "Types passed"

  step "Running unit tests"
  (cd "$DIR" && npm run --silent test) || { fail "Unit tests failed"; exit 1; }
  ok "Tests passed"
}

header "PRE-COMMIT CHECKS"

has_staged certinova-backend && check_legacy certinova-backend false
has_staged certinova-frontend && check_legacy certinova-frontend true
has_staged apps/api && check_python apps/api
has_staged tools/migrate && check_python tools/migrate
has_staged hasura/tests && check_python hasura/tests
has_staged apps/web && check_web apps/web

echo ""
printf "${GREEN}${BOLD}============================================================${RESET}\n"
printf "${GREEN}${BOLD}                 ALL CHECKS PASSED${RESET}\n"
printf "${GREEN}${BOLD}============================================================${RESET}\n"
