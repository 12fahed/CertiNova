# tools/migrate — copy to tools/migrate/.env. Never commit real values.

# Source: production MongoDB (use a read-only user)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_DB=certinova

# Target: Supabase Postgres (direct connection, not the transaction pooler)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Old template images are copied from Cloudinary to Supabase Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# true = read and report only, write nothing
DRY_RUN=true
