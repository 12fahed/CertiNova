# hasura/ — copy to hasura/.env. The Hasura CLI reads it. Never commit real values.

# Hasura Cloud project > API > GraphQL endpoint, without /v1/graphql
HASURA_GRAPHQL_ENDPOINT=https://<project>.hasura.app
HASURA_GRAPHQL_ADMIN_SECRET=

# The values below live in Hasura Cloud > Env vars, not in this file.
# Listed here so every secret has one home:
#   PG_DATABASE_URL                   Supabase Postgres (session pooler)
#   HASURA_GRAPHQL_JWT_SECRET         {"type":"RS256","jwk_url":"https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"}  (P2)
#   HASURA_GRAPHQL_UNAUTHORIZED_ROLE  anonymous  (P2)
#   ACTION_BASE_URL                   Flask API base URL on Render  (P2)
#   HASURA_ACTION_SECRET              same value as apps/api HASURA_ACTION_SECRET  (P2)
